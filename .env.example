# ============================================
# NetPad - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# Deployment Mode
# ============================================

# Deployment mode determines infrastructure and feature availability
#
# Options:
# - 'cloud': Running as hosted SaaS (e.g., on Vercel)
#            - Knowledge-Guided Conversational Forms (RAG) require PRO, TEAMS, or ENTERPRISE subscription
#            - Works with any Atlas cluster tier (M0 free tier and above)
#            - Production reliability with MongoDB Atlas SLA
#
# - 'self-hosted': Running privately/locally
#            - RAG features available to ALL subscription tiers
#            - Works with any Atlas cluster tier or Atlas Local (Docker)
#            - User is responsible for running and managing their MongoDB instance
#
# For self-hosted deployments with RAG/Vector Search:
#   1. Install Atlas CLI: https://www.mongodb.com/docs/atlas/cli/current/install-atlas-cli/
#   2. Create local deployment: atlas deployments setup local --type local
#   3. Or use Docker: docker run -d -p 27017:27017 mongodb/mongodb-atlas-local
#   4. Set MONGODB_URI to your local deployment connection string
#
# Documentation: https://www.mongodb.com/docs/atlas/cli/current/atlas-cli-deploy-local/
NETPAD_PLATFORM_MODE=cloud

# Client-side platform mode (must match NETPAD_PLATFORM_MODE)
# This exposes the platform mode to client components (e.g., user menu badge)
NEXT_PUBLIC_NETPAD_PLATFORM_MODE=cloud

# ============================================
# Database Configuration
# ============================================

# Main MongoDB connection for the platform database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# Platform database name (shared database for users, orgs, etc.)
PLATFORM_DB_NAME=form_builder_platform

# Legacy: Original database name (for backward compatibility)
MONGODB_DATABASE=form_builder

# ============================================
# Session & Encryption
# ============================================

# Session secret - REQUIRED - at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-super-secret-session-key-at-least-32-chars

# Vault encryption key - REQUIRED for connection vault
# Generate with: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# RAG connection string encryption key - REQUIRED for user-cluster storage
# Generate with: openssl rand -hex 32
# Used to encrypt MongoDB connection strings for user-cluster RAG storage
ENCRYPTION_KEY=your-64-character-hex-key

# ============================================
# OAuth Providers (Optional)
# ============================================

# Google OAuth
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# Email Configuration (for Magic Links)
# ============================================

# SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# From address for emails
FROM_EMAIL=noreply@yourdomain.com

# ============================================
# WebAuthn / Passkeys
# ============================================

# Relying Party ID - your domain (localhost for development)
WEBAUTHN_RP_ID=localhost

# Relying Party Name - shown in passkey prompts
WEBAUTHN_RP_NAME=NetPad

# ============================================
# Application URLs
# ============================================

# Server-side URL (for OAuth callbacks, webhooks, etc.)
# REQUIRED in production - set this to your production domain
APP_URL=https://www.netpad.io

# Public URL of your application (for client-side use)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Optional: AI Features
# ============================================

# OpenAI API key for AI-powered features (LLM and embeddings fallback)
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: OpenAI embedding model (default: text-embedding-3-small)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# MongoDB Atlas Embedding and Reranking API (NEW - Recommended)
# ============================================

# MongoDB Atlas Model API Key (for embeddings and reranking)
# Get from: MongoDB Atlas UI > Project Settings > Model API Keys
# https://www.mongodb.com/docs/voyageai/
#
# This is MongoDB's first-party embedding and reranking service with:
# - Unified billing with Atlas (single vendor)
# - Enterprise security and authentication
# - Voyage 4 series models with shared embedding space
# - 200M tokens free tier per month
#
# If not set, falls back to VOYAGE_API_KEY for backward compatibility
ATLAS_MODEL_API_KEY=

# Voyage AI model selection (default: voyage-4)
# Voyage 4 series (recommended - shared embedding space):
#   - voyage-4-large (1024d*, highest quality)
#   - voyage-4 (1024d*, general purpose)
#   - voyage-4-lite (1024d*, low latency, cheapest)
# Domain-specific models:
#   - voyage-finance-2 (1024d, finance/trading)
#   - voyage-law-2 (1024d, legal documents)
#   - voyage-code-3 (1024d, source code)
# *Voyage 4 supports configurable dimensions: 256, 512, 1024, 2048
VOYAGE_MODEL=voyage-4

# Optional: Output dimensions for Voyage 4 models (256, 512, 1024, 2048)
# Default: 1024 - only change if you need different dimensions
# WARNING: Changing dimensions requires re-indexing all documents
# VOYAGE_EMBEDDING_DIMENSIONS=1024

# Enable/disable Atlas Embedding API (default: true)
# Set to 'false' to use direct Voyage API instead
ATLAS_EMBEDDING_API=true

# ============================================
# Optional: Two-Stage Retrieval with Reranking
# ============================================

# Enable reranking for improved RAG quality (default: true)
# Two-stage retrieval: Vector Search (recall) + Reranking (precision)
# Research shows 10-30% improvement in retrieval quality
VOYAGE_RERANK_ENABLED=true

# Reranking model (default: rerank-2.5-lite)
# Options:
#   - rerank-2.5-lite (32K context, low latency, recommended)
#   - rerank-2.5 (32K context, highest quality)
#   - rerank-2 (16K context, legacy)
VOYAGE_RERANK_MODEL=rerank-2.5-lite

# Enable/disable Atlas Reranking API (default: true)
# Set to 'false' to use direct Voyage reranking API
ATLAS_RERANK_API=true

# ============================================
# Legacy: Direct Voyage AI API (Fallback)
# ============================================

# Direct Voyage AI API key (for self-hosted without Atlas)
# Get from: https://dash.voyageai.com/api-keys
# Only needed if not using Atlas Embedding API
# Falls back to this if ATLAS_MODEL_API_KEY is not set
VOYAGE_API_KEY=

# ============================================
# Optional: Embedding Provider Override
# ============================================

# Force a specific embedding provider (overrides auto-detection)
# Options: auto | atlas-embedding-api | voyage | openai
# Default: auto (Atlas Embedding API -> Voyage Direct -> OpenAI)
# Priority:
#   1. Atlas Embedding API (if ATLAS_MODEL_API_KEY or VOYAGE_API_KEY set)
#   2. Direct Voyage API (fallback for self-hosted)
#   3. OpenAI (final fallback)
EMBEDDING_PROVIDER=auto

# ============================================
# Optional: Stripe Billing
# ============================================

# Stripe API keys
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_TEAM_MONTHLY=price_xxx
STRIPE_PRICE_TEAM_YEARLY=price_xxx

# ============================================
# Optional: File Storage (Vercel Blob)
# ============================================

# Vercel Blob store token
# Get from: https://vercel.com/dashboard/stores
# Required for file/image uploads in forms
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token-here

# ============================================
# Optional: Bot Protection
# ============================================

# Cloudflare Turnstile (bot protection for forms)
# Get from: https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# ============================================
# Workflow Processing (Vercel Cron)
# ============================================

# Secret for authenticating cron job requests
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel automatically authenticates cron requests, but this adds an extra layer
CRON_SECRET=

# ============================================
# Optional: Legacy Auth Database
# ============================================

# Separate auth database (defaults to MONGODB_URI if not set)
AUTH_MONGODB_URI=
AUTH_DB_NAME=mdb_tools_auth

# ============================================
# Optional: MongoDB Atlas Admin API
# ============================================

# Atlas API credentials for automatic M0 cluster provisioning
# Create API key at: https://cloud.mongodb.com/v2#/org/<orgId>/access/apiKeys
# Required permissions: Organization Project Creator

# Your Atlas organization ID (found in Atlas URL or Organization Settings)
ATLAS_ORG_ID=

# API Key Public Key
ATLAS_PUBLIC_KEY=

# API Key Private Key
ATLAS_PRIVATE_KEY=

# Default cloud provider for provisioned clusters (AWS, GCP, AZURE)
ATLAS_DEFAULT_PROVIDER=AWS

# Default region for provisioned clusters
# AWS: US_EAST_1, US_WEST_2, EU_WEST_1, etc.
# GCP: CENTRAL_US, EASTERN_US, WESTERN_EUROPE, etc.
# Azure: US_EAST_2, EUROPE_NORTH, etc.
ATLAS_DEFAULT_REGION=US_EAST_1

# Server IP addresses to add to cluster access list (comma-separated)
# Leave empty to allow all IPs (0.0.0.0/0) - not recommended for production
ATLAS_SERVER_IPS=

# ============================================
# Platform Administration
# ============================================

# Comma-separated list of emails that should have platform admin access
# These users will automatically be granted platform admin role on login
# Example: admin@example.com,superuser@example.com
PLATFORM_ADMIN_EMAILS=michael@netpad.io

# ============================================
# Optional: Vercel Integration
# ============================================

# Vercel Integration OAuth credentials
# Create at: https://vercel.com/dashboard/integrations
# Only needed if building a custom Vercel integration
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

