{
  "name": "netpad",
  "version": "3.1.1",
  "description": "NetPad - Build and publish MongoDB-connected data forms and workflows",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:packages": "npm run build --prefix packages/templates && npm run build --prefix packages/forms && npm run build --prefix packages/collaborate && npm run build --prefix packages/demo-node",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:marketplace": "tsx scripts/seed-marketplace.ts",
    "verify:marketplace": "tsx scripts/verify-marketplace.ts",
    "test:npm-sync": "tsx scripts/test-npm-sync.ts",
    "test:contracts": "tsx scripts/test-contracts.ts",
    "migrate:default-applications": "tsx scripts/migrate-default-applications.ts",
    "migrate:backfill-application-ids": "tsx scripts/migrate-backfill-application-ids.ts",
    "seed:workflow-templates": "tsx scripts/seed-workflow-templates.ts",
    "seed:collaborator-form": "tsx scripts/seed-collaborator-form.ts",
    "publish:it-helpdesk": "tsx scripts/publish-it-helpdesk-marketplace.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:headed": "tsx scripts/benchmark.ts --headed",
    "setup-rag-index": "tsx scripts/rag/setup-vector-index.ts",
    "setup-rag-db": "tsx scripts/rag/setup-database-only.ts",
    "list-orgs": "tsx scripts/rag/list-organizations.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.3",
    "@dagrejs/graphlib": "^2.2.4",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-date-pickers": "^8.22.1",
    "@netpad/collaborate": "file:packages/collaborate",
    "@netpad/demo-node": "file:packages/demo-node",
    "@netpad/forms": "file:packages/forms",
    "@netpad/netpad-ext-approval-gate": "^1.0.3",
    "@netpad/templates": "file:packages/templates",
    "@netpad/workflow-renderer": "^1.0.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.0",
    "allotment": "^1.20.4",
    "bcryptjs": "^3.0.3",
    "crypto-js": "^4.2.0",
    "csv-writer": "^1.6.0",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "iron-session": "^8.0.4",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "mermaid": "^11.12.2",
    "mongodb": "^6.5.0",
    "mongodb-client-encryption": "^6.5.0",
    "nanoid": "^5.1.6",
    "next": "14.2.35",
    "nodemailer": "^7.0.11",
    "npm-registry-fetch": "^19.1.1",
    "openai": "^6.15.0",
    "pdf-parse": "^1.1.4",
    "react": "^18.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "reactflow": "^11.10.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^20.1.0",
    "swr": "^2.3.8",
    "tar": "^7.5.2",
    "xlsx": "^0.18.5",
    "zundo": "^2.3.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.4",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "@netpad/cloud-features": "file:../netpad-cloud"
  }
}
