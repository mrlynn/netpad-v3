{
  "id": "customer-search",
  "name": "Customer Search",
  "description": "Search and filter customers by name, email, company, status, and more",
  "icon": "🔍",
  "category": "search",
  "complexity": "moderate",
  "estimatedTime": "5 minutes",
  "formType": "search",
  "searchConfig": {
    "enabled": true,
    "fields": {
      "email": {
        "enabled": true,
        "operators": ["contains", "equals", "startsWith"],
        "defaultOperator": "contains",
        "showInResults": true,
        "resultOrder": 2,
        "placeholder": "Search by email...",
        "optionsSource": {
          "type": "distinct",
          "distinct": {
            "showCounts": true,
            "sortBy": "count",
            "sortDirection": "desc",
            "limit": 50
          },
          "refreshOnMount": true
        }
      },
      "fullName": {
        "enabled": true,
        "operators": ["contains", "equals", "startsWith"],
        "defaultOperator": "contains",
        "showInResults": true,
        "resultOrder": 1,
        "placeholder": "Search by name...",
        "optionsSource": {
          "type": "distinct",
          "distinct": {
            "showCounts": true,
            "sortBy": "count",
            "sortDirection": "desc",
            "limit": 50
          },
          "refreshOnMount": true
        }
      },
      "company": {
        "enabled": true,
        "operators": ["contains", "equals", "startsWith"],
        "defaultOperator": "contains",
        "showInResults": true,
        "resultOrder": 3,
        "placeholder": "Search by company...",
        "optionsSource": {
          "type": "distinct",
          "distinct": {
            "showCounts": true,
            "sortBy": "count",
            "sortDirection": "desc",
            "limit": 50
          },
          "refreshOnMount": true
        }
      },
      "status": {
        "enabled": true,
        "operators": ["equals", "in"],
        "defaultOperator": "equals",
        "showInResults": true,
        "resultOrder": 4,
        "placeholder": "Filter by status"
      },
      "phone": {
        "enabled": true,
        "operators": ["contains", "equals"],
        "defaultOperator": "contains",
        "showInResults": false,
        "placeholder": "Search by phone..."
      },
      "createdAt": {
        "enabled": true,
        "operators": ["greaterThan", "lessThan", "between"],
        "defaultOperator": "between",
        "showInResults": true,
        "resultOrder": 0,
        "helpText": "Filter by creation date"
      }
    },
    "results": {
      "layout": "table",
      "pageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100],
      "showPagination": true,
      "allowView": true,
      "allowEdit": true,
      "allowDelete": false,
      "allowExport": true,
      "allowSorting": true,
      "allowSelection": true,
      "allowBulkActions": false,
      "defaultSortField": "createdAt",
      "defaultSortDirection": "desc"
    },
    "maxResults": 500
  },
  "fields": [
    {
      "path": "fullName",
      "label": "Full Name",
      "type": "string",
      "included": true,
      "required": false,
      "fieldWidth": "half",
      "placeholder": "Search by name..."
    },
    {
      "path": "email",
      "label": "Email",
      "type": "email",
      "included": true,
      "required": false,
      "fieldWidth": "half",
      "placeholder": "Search by email..."
    },
    {
      "path": "company",
      "label": "Company",
      "type": "string",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Search by company..."
    },
    {
      "path": "status",
      "label": "Status",
      "type": "dropdown",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Any status",
      "validation": {
        "options": [
          { "label": "Active", "value": "active" },
          { "label": "Inactive", "value": "inactive" },
          { "label": "Pending", "value": "pending" },
          { "label": "VIP", "value": "vip" }
        ],
        "clearable": true
      }
    },
    {
      "path": "phone",
      "label": "Phone",
      "type": "string",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Search by phone..."
    },
    {
      "path": "createdAt",
      "label": "Created Date",
      "type": "date",
      "included": true,
      "required": false,
      "fieldWidth": "half",
      "placeholder": "Filter by date range"
    }
  ]
}
