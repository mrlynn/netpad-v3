{
  "id": "support-ticket-search",
  "name": "Support Ticket Search",
  "description": "Search and manage support tickets by status, priority, category, reporter, and date",
  "icon": "🎫",
  "category": "search",
  "complexity": "moderate",
  "estimatedTime": "5 minutes",
  "formType": "search",
  "searchConfig": {
    "enabled": true,
    "fields": {
      "ticketNumber": {
        "enabled": true,
        "operators": ["contains", "equals"],
        "defaultOperator": "contains",
        "showInResults": true,
        "resultOrder": 1,
        "placeholder": "Search by ticket number..."
      },
      "subject": {
        "enabled": true,
        "operators": ["contains", "startsWith", "regex"],
        "defaultOperator": "contains",
        "showInResults": true,
        "resultOrder": 2,
        "placeholder": "Search ticket subjects..."
      },
      "reporterEmail": {
        "enabled": true,
        "operators": ["contains", "equals"],
        "defaultOperator": "contains",
        "showInResults": true,
        "resultOrder": 4,
        "placeholder": "Search by reporter email...",
        "optionsSource": {
          "type": "distinct",
          "distinct": {
            "showCounts": true,
            "sortBy": "count",
            "sortDirection": "desc",
            "limit": 50
          },
          "refreshOnMount": true
        }
      },
      "reporterName": {
        "enabled": true,
        "operators": ["contains", "equals", "startsWith"],
        "defaultOperator": "contains",
        "showInResults": true,
        "resultOrder": 3,
        "placeholder": "Search by reporter name...",
        "optionsSource": {
          "type": "distinct",
          "distinct": {
            "showCounts": true,
            "sortBy": "count",
            "sortDirection": "desc",
            "limit": 50
          },
          "refreshOnMount": true
        }
      },
      "status": {
        "enabled": true,
        "operators": ["equals", "in"],
        "defaultOperator": "equals",
        "showInResults": true,
        "resultOrder": 5,
        "placeholder": "Filter by status",
        "optionsSource": {
          "type": "distinct",
          "distinct": {
            "showCounts": true,
            "sortBy": "count",
            "sortDirection": "desc"
          },
          "refreshOnMount": true
        }
      },
      "priority": {
        "enabled": true,
        "operators": ["equals", "in"],
        "defaultOperator": "equals",
        "showInResults": true,
        "resultOrder": 6,
        "placeholder": "Filter by priority"
      },
      "category": {
        "enabled": true,
        "operators": ["equals", "in"],
        "defaultOperator": "equals",
        "showInResults": true,
        "resultOrder": 7,
        "placeholder": "Filter by category",
        "optionsSource": {
          "type": "distinct",
          "distinct": {
            "showCounts": true,
            "sortBy": "count",
            "sortDirection": "desc",
            "limit": 20
          },
          "refreshOnMount": true
        }
      },
      "createdAt": {
        "enabled": true,
        "operators": ["greaterThan", "lessThan", "between"],
        "defaultOperator": "between",
        "showInResults": true,
        "resultOrder": 0,
        "helpText": "Filter tickets by creation date"
      },
      "description": {
        "enabled": true,
        "operators": ["contains", "regex"],
        "defaultOperator": "contains",
        "showInResults": false,
        "placeholder": "Search in descriptions..."
      }
    },
    "results": {
      "layout": "table",
      "pageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100],
      "showPagination": true,
      "allowView": true,
      "allowEdit": true,
      "allowDelete": false,
      "allowExport": true,
      "allowSorting": true,
      "allowSelection": true,
      "allowBulkActions": true,
      "defaultSortField": "createdAt",
      "defaultSortDirection": "desc"
    },
    "maxResults": 500
  },
  "fields": [
    {
      "path": "ticketNumber",
      "label": "Ticket Number",
      "type": "string",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Search by ticket number..."
    },
    {
      "path": "subject",
      "label": "Subject",
      "type": "string",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Search ticket subjects..."
    },
    {
      "path": "status",
      "label": "Status",
      "type": "dropdown",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Any status",
      "validation": {
        "options": [
          { "label": "Open", "value": "open" },
          { "label": "In Progress", "value": "in-progress" },
          { "label": "Resolved", "value": "resolved" },
          { "label": "Closed", "value": "closed" }
        ],
        "clearable": true
      }
    },
    {
      "path": "reporterName",
      "label": "Reporter Name",
      "type": "string",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Search by reporter name..."
    },
    {
      "path": "reporterEmail",
      "label": "Reporter Email",
      "type": "email",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Search by reporter email..."
    },
    {
      "path": "priority",
      "label": "Priority",
      "type": "dropdown",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Any priority",
      "validation": {
        "options": [
          { "label": "Low", "value": "low" },
          { "label": "Medium", "value": "medium" },
          { "label": "High", "value": "high" },
          { "label": "Urgent", "value": "urgent" }
        ],
        "clearable": true
      }
    },
    {
      "path": "category",
      "label": "Category",
      "type": "dropdown",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Any category",
      "validation": {
        "options": [
          { "label": "Technical", "value": "technical" },
          { "label": "Billing", "value": "billing" },
          { "label": "Account", "value": "account" },
          { "label": "Feature Request", "value": "feature-request" },
          { "label": "Bug Report", "value": "bug" },
          { "label": "Other", "value": "other" }
        ],
        "clearable": true
      }
    },
    {
      "path": "createdAt",
      "label": "Created Date",
      "type": "date",
      "included": true,
      "required": false,
      "fieldWidth": "half",
      "placeholder": "Filter by date range"
    },
    {
      "path": "description",
      "label": "Description",
      "type": "string",
      "included": true,
      "required": false,
      "fieldWidth": "half",
      "placeholder": "Search in descriptions..."
    }
  ]
}
