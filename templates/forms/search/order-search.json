{
  "id": "order-search",
  "name": "Order Search",
  "description": "Search and filter orders by status, date range, customer, order number, and more",
  "icon": "🛒",
  "category": "search",
  "complexity": "moderate",
  "estimatedTime": "5 minutes",
  "formType": "search",
  "searchConfig": {
    "enabled": true,
    "fields": {
      "orderNumber": {
        "enabled": true,
        "operators": ["contains", "equals", "startsWith"],
        "defaultOperator": "contains",
        "showInResults": true,
        "resultOrder": 1,
        "placeholder": "Search by order number..."
      },
      "customerEmail": {
        "enabled": true,
        "operators": ["contains", "equals"],
        "defaultOperator": "contains",
        "showInResults": true,
        "resultOrder": 3,
        "placeholder": "Search by customer email...",
        "optionsSource": {
          "type": "distinct",
          "distinct": {
            "showCounts": true,
            "sortBy": "count",
            "sortDirection": "desc",
            "limit": 50
          },
          "refreshOnMount": true
        }
      },
      "customerName": {
        "enabled": true,
        "operators": ["contains", "equals", "startsWith"],
        "defaultOperator": "contains",
        "showInResults": true,
        "resultOrder": 2,
        "placeholder": "Search by customer name...",
        "optionsSource": {
          "type": "distinct",
          "distinct": {
            "showCounts": true,
            "sortBy": "count",
            "sortDirection": "desc",
            "limit": 50
          },
          "refreshOnMount": true
        }
      },
      "status": {
        "enabled": true,
        "operators": ["equals", "in"],
        "defaultOperator": "equals",
        "showInResults": true,
        "resultOrder": 4,
        "placeholder": "Filter by status",
        "optionsSource": {
          "type": "distinct",
          "distinct": {
            "showCounts": true,
            "sortBy": "count",
            "sortDirection": "desc"
          },
          "refreshOnMount": true
        }
      },
      "total": {
        "enabled": true,
        "operators": ["greaterThan", "lessThan", "between", "equals"],
        "defaultOperator": "between",
        "showInResults": true,
        "resultOrder": 5,
        "placeholder": "Filter by order total",
        "helpText": "Filter by order amount range"
      },
      "orderDate": {
        "enabled": true,
        "operators": ["greaterThan", "lessThan", "between"],
        "defaultOperator": "between",
        "showInResults": true,
        "resultOrder": 0,
        "helpText": "Filter by order date range"
      },
      "productName": {
        "enabled": true,
        "operators": ["contains", "equals"],
        "defaultOperator": "contains",
        "showInResults": false,
        "placeholder": "Search by product..."
      }
    },
    "results": {
      "layout": "table",
      "pageSize": 25,
      "pageSizeOptions": [10, 25, 50, 100],
      "showPagination": true,
      "allowView": true,
      "allowEdit": true,
      "allowDelete": false,
      "allowExport": true,
      "allowSorting": true,
      "allowSelection": true,
      "allowBulkActions": true,
      "defaultSortField": "orderDate",
      "defaultSortDirection": "desc"
    },
    "maxResults": 500
  },
  "fields": [
    {
      "path": "orderNumber",
      "label": "Order Number",
      "type": "string",
      "included": true,
      "required": false,
      "fieldWidth": "half",
      "placeholder": "Search by order number..."
    },
    {
      "path": "customerEmail",
      "label": "Customer Email",
      "type": "email",
      "included": true,
      "required": false,
      "fieldWidth": "half",
      "placeholder": "Search by customer email..."
    },
    {
      "path": "customerName",
      "label": "Customer Name",
      "type": "string",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Search by customer name..."
    },
    {
      "path": "status",
      "label": "Order Status",
      "type": "dropdown",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Any status",
      "validation": {
        "options": [
          { "label": "Pending", "value": "pending" },
          { "label": "Processing", "value": "processing" },
          { "label": "Shipped", "value": "shipped" },
          { "label": "Delivered", "value": "delivered" },
          { "label": "Cancelled", "value": "cancelled" },
          { "label": "Refunded", "value": "refunded" }
        ],
        "clearable": true
      }
    },
    {
      "path": "orderDate",
      "label": "Order Date",
      "type": "date",
      "included": true,
      "required": false,
      "fieldWidth": "third",
      "placeholder": "Filter by date range"
    },
    {
      "path": "total",
      "label": "Order Total",
      "type": "number",
      "included": true,
      "required": false,
      "fieldWidth": "half",
      "placeholder": "Filter by amount range"
    },
    {
      "path": "productName",
      "label": "Product",
      "type": "string",
      "included": true,
      "required": false,
      "fieldWidth": "half",
      "placeholder": "Search by product name..."
    }
  ]
}
