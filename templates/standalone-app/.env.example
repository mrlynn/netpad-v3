# MongoDB Connection
# Required: Your MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=netpad_app

# Application URL (used for callbacks and links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Standalone mode flag (set automatically by deployment)
STANDALONE_MODE=true

# Optional: Session secret for authentication features
# SESSION_SECRET=your-session-secret-min-32-chars

# Optional: Vault encryption key for secure storage
# VAULT_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# ============================================
# AI Configuration (for Conversational Forms)
# ============================================
# Required for conversational forms to work.
# Get your API key from https://platform.openai.com/api-keys

# OpenAI API Key (required for conversational forms)
# OPENAI_API_KEY=sk-your-api-key-here

# Optional: Override the default model (gpt-4o-mini is recommended for cost-effectiveness)
# Available models: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# OPENAI_MODEL=gpt-4o-mini
