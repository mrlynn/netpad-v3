{
  "name": "@netpad/chatgpt-app",
  "version": "1.0.0",
  "description": "ChatGPT App for NetPad - build forms, workflows, and applications from ChatGPT conversations",
  "author": "Michael Lynn",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "netpad-chatgpt": "./dist/server.js"
  },
  "files": [
    "dist",
    "widgets",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:widgets",
    "build:server": "tsup",
    "build:widgets": "node scripts/build-widgets.js",
    "dev": "npm run build:widgets && tsup --watch",
    "dev:server": "node --watch dist/server.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "tunnel": "ngrok http 2091",
    "prepublishOnly": "npm run build && npm run typecheck",
    "test": "echo 'No tests yet'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@netpad/mcp-apps": "^1.0.0",
    "@netpad/templates": "^1.0.1",
    "express": "^4.18.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@vercel/node": "^3.2.29",
    "esbuild": "^0.20.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "chatgpt",
    "openai",
    "apps-sdk",
    "mcp",
    "model-context-protocol",
    "netpad",
    "forms",
    "workflows",
    "mongodb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrlynn/netpad-v3.git",
    "directory": "packages/chatgpt-app"
  },
  "bugs": {
    "url": "https://github.com/mrlynn/netpad-v3/issues"
  },
  "homepage": "https://github.com/mrlynn/netpad-v3/tree/main/packages/chatgpt-app#readme",
  "publishConfig": {
    "access": "public"
  }
}
