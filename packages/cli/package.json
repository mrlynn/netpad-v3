{
  "name": "@netpad/cli",
  "version": "0.2.0",
  "description": "NetPad CLI tool for managing applications and plugins from npm",
  "type": "module",
  "bin": {
    "netpad": "./dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "echo 'Run manual tests - see TEST_PLAN.md'",
    "test:all": "bash scripts/test-cli.sh",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck"
  },
  "keywords": [
    "netpad",
    "cli",
    "forms",
    "workflows",
    "mongodb",
    "npm",
    "marketplace",
    "applications"
  ],
  "author": "MongoDB",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrlynn/netpad-v3.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/mrlynn/netpad-v3/issues"
  },
  "homepage": "https://github.com/mrlynn/netpad-v3/tree/main/packages/cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "inquirer": "^10.0.0",
    "chalk": "^5.3.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
